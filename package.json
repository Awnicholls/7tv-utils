{
  "name": "7tv-emote-copier",
  "version": "0.2.0",
  "description": "Copy 7TV emote sets in one click. Apple-minimal desktop app (Electron + React).",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "license": "MIT",
  "author": "",
  "homepage": "https://github.com/TaahDev/7tv-copy-emote-set",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "dist": "yarn build && electron-builder",
    "dist:win": "yarn build && electron-builder --win portable",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^5.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unicorn": "^74.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "app.seventv.emotecopier",
    "productName": "7TV Emote Copier",
    "artifactName": "7tv-emote-copier-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!**/*.map",
      "!**/*.tsbuildinfo",
      "package.json"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "7tv-emote-copier.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TaahDev/7tv-copy-emote-set.git"
  },
  "keywords": [
    "7tv",
    "twitch",
    "emotes",
    "electron",
    "react"
  ],
  "packageManager": "yarn@4.18.1"
}
